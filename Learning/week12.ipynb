      "source": [
        "import gradio as gr\n",
        "from transformers import pipeline\n",
        "\n",
        "classifier = pipeline(\"sentiment-analysis\")\n",
        "\n",
        "def analyze(text):\n",
        "    result = classifier(text)\n",
        "    return result\n",
        "\n",
        "interface = gr.Interface(\n",
        "    fn=analyze,\n",
        "    inputs=\"text\",\n",
        "    outputs=\"text\"\n",
        ")\n",
        "\n",
        "interface.launch()"
      ]
    }
